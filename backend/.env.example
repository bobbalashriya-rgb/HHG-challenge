# Django Configuration
SECRET_KEY=your-secure-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# PostgreSQL Database Configuration
# Option A: Discrete variables
DB_ENGINE=django.db.backends.postgresql
DB_NAME=finolitics
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Option B: Full Database URL (overrides discrete variables if set)
# DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/finolitics


# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here

# Service Bindings
WISPRFLOW_URL=http://wisprflow:8002

